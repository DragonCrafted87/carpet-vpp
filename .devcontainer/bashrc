#!/usr/bin/env bash

# carpet-vpp helpers. Source from the host or from inside the container:
#   source .devcontainer/bashrc
#   vpp-help
#
# Naming: vpp-<area>-<verb>
#   vpp-up / vpp-down / vpp-exec   container lifecycle
#   vpp-test / vpp-game-test       Gradle tests
#   vpp-client / vpp-server / vpp-play   game launches
#
# Host: most commands start the container if needed (devcontainer up),
# then run via `devcontainer exec`. vpp-down stops and removes it.
# Interactive host shells trap EXIT/HUP so closing the terminal usually downs
# the container (refcount across shells). Not 100%: kill -9, crash, or a still-
# open sibling shell will skip it.
# Attached VS Code sessions also stop on window/folder close (shutdownAction).

_VPP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
_VPP_REF_FILE="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/vpp-dev-$(
    printf '%s' "${_VPP_ROOT}" | tr '/:' '__'
).ref"

_vpp_in_container() {
    [[ -n "${REMOTE_CONTAINERS:-}" || -n "${DEVCONTAINER:-}" || -f /.dockerenv ]]
}

_vpp_need_host_cli() {
    if _vpp_in_container; then
        return 0
    fi
    if ! command -v devcontainer >/dev/null 2>&1; then
        echo "vpp: devcontainer CLI not on PATH." >&2
        echo "vpp: install @devcontainers/cli, or source this file inside the container." >&2
        return 127
    fi
}

_vpp_need_host() {
    if _vpp_in_container; then
        echo "vpp: run this on the host, not inside the container." >&2
        return 1
    fi
}

_vpp_realpath() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1"
    else
        (cd "$1" && pwd -P)
    fi
}

_vpp_container_ids() {
    command -v docker >/dev/null 2>&1 || return 0
    local folder rp
    folder="${_VPP_ROOT}"
    rp="$(_vpp_realpath "${folder}")"
    {
        docker ps -aq --filter "label=devcontainer.local_folder=${folder}"
        docker ps -aq --filter "label=devcontainer.local_folder=${rp}"
    } 2>/dev/null | awk 'NF && !seen[$0]++'
}

_vpp_exec_ready() {
    devcontainer exec --workspace-folder "${_VPP_ROOT}" -- true >/dev/null 2>&1
}

_vpp_up_if_needed() {
    _vpp_need_host_cli || return
    if _vpp_in_container; then
        return 0
    fi
    if _vpp_exec_ready; then
        return 0
    fi
    echo "vpp: starting devcontainer..." >&2
    vpp-up
}

_vpp_exec() {
    if _vpp_in_container; then
        (
            cd "${_VPP_ROOT}"
            "$@"
        )
        return
    fi
    _vpp_up_if_needed || return
    devcontainer exec --workspace-folder "${_VPP_ROOT}" -- "$@"
}

_vpp_ref_do() {
    local op="$1"
    (
        umask 077
        mkdir -p "$(dirname "${_VPP_REF_FILE}")"
        if command -v flock >/dev/null 2>&1; then
            exec 9>"${_VPP_REF_FILE}.lock"
            flock 9
        fi
        local n=0
        if [[ -f "${_VPP_REF_FILE}" ]]; then
            n="$(tr -dc '0-9' <"${_VPP_REF_FILE}")"
            n="${n:-0}"
        fi
        if [[ "${op}" == inc ]]; then
            echo $((n + 1)) >"${_VPP_REF_FILE}"
            exit 0
        fi
        n=$((n - 1))
        if ((n <= 0)); then
            rm -f "${_VPP_REF_FILE}"
            exit 1
        fi
        echo "${n}" >"${_VPP_REF_FILE}"
        exit 0
    )
}

_vpp_on_hangup() {
    [[ -n "${_VPP_TRAP_FIRED:-}" ]] && return 0
    _VPP_TRAP_FIRED=1
    trap - EXIT HUP
    if _vpp_in_container; then
        return 0
    fi
    if _vpp_ref_do dec; then
        return 0
    fi
    vpp-down -q || true
}

# Headless client runs have no host Wayland socket. Start Xvfb then.
_vpp_ensure_display() {
    if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        return 0
    fi
    if ! command -v Xvfb >/dev/null 2>&1; then
        echo "vpp: no display and Xvfb is not installed" >&2
        return 1
    fi
    if ! pgrep -f 'Xvfb :99' >/dev/null 2>&1; then
        Xvfb :99 -screen 0 1280x720x24 >/tmp/xvfb.log 2>&1 &
    fi
    export DISPLAY=:99
    export LIBGL_ALWAYS_SOFTWARE=1
}

vpp-up() {
    if _vpp_in_container; then
        echo "vpp: already inside the container" >&2
        return 0
    fi
    _vpp_need_host_cli || return
    devcontainer up --workspace-folder "${_VPP_ROOT}"
}

vpp-down() {
    local quiet=0
    if [[ "${1:-}" == "-q" ]]; then
        quiet=1
        shift
    fi
    if _vpp_in_container; then
        echo "vpp: refuse to down from inside the container; run vpp-down on the host" >&2
        return 1
    fi
    if command -v devcontainer >/dev/null 2>&1; then
        if devcontainer down --workspace-folder "${_VPP_ROOT}" >/dev/null 2>&1; then
            ((quiet)) || echo "vpp: down" >&2
            return 0
        fi
    fi
    if ! command -v docker >/dev/null 2>&1; then
        ((quiet)) || echo "vpp: docker not on PATH; cannot stop the container" >&2
        return 127
    fi
    local -a ids
    readarray -t ids < <(_vpp_container_ids)
    if [[ ${#ids[@]} -eq 0 ]]; then
        ((quiet)) || echo "vpp: no container for ${_VPP_ROOT}" >&2
        return 0
    fi
    docker rm -f "${ids[@]}" >/dev/null
    ((quiet)) || echo "vpp: down" >&2
}

vpp-exec() {
    _vpp_exec "$@"
}

vpp-test() {
    _vpp_exec ./gradlew test "$@"
}

vpp-game-test() {
    _vpp_exec ./gradlew runGameTest "$@"
}

vpp-client-test() {
    _vpp_exec bash -lc 'source .devcontainer/bashrc; _vpp_ensure_display; ./gradlew runClientGameTest'
}

vpp-build() {
    _vpp_exec ./gradlew build "$@"
}

vpp-datagen() {
    _vpp_exec ./gradlew runDatagen "$@"
}

vpp-server() {
    _vpp_exec ./gradlew runServer "$@"
}

vpp-client() {
    _vpp_exec bash -lc 'source .devcontainer/bashrc; _vpp_ensure_display; ./gradlew runClient'
}

# server-port from run/server.properties, or 25565 when the line is absent.
# An optional path argument is for checks; the play launch calls this with none.
_vpp_server_port() {
    local file="${1:-${_VPP_ROOT}/run/server.properties}"
    local port=25565
    local line=""
    if [[ -f "${file}" ]]; then
        line="$(grep -E '^[[:space:]]*server-port=' "${file}" | tail -n 1 || true)"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ "${line}" =~ ^server-port=([0-9]+)$ ]]; then
            port="${BASH_REMATCH[1]}"
        fi
    fi
    printf '%s\n' "${port}"
}

_vpp_port_open() {
    local port="$1"
    ( : >/dev/tcp/127.0.0.1/"${port}" ) >/dev/null 2>&1
}

# TERM the pid, then KILL it if it is still alive after 5 seconds.
_vpp_stop_pid() {
    local pid="$1"
    local i
    [[ "${pid}" =~ ^[0-9]+$ ]] || return 0
    if ((pid <= 1)); then
        return 0
    fi
    if kill -0 "${pid}" 2>/dev/null; then
        kill -TERM "${pid}" 2>/dev/null || true
        for ((i = 1; i <= 5; i++)); do
            kill -0 "${pid}" 2>/dev/null || break
            sleep 1
        done
        if kill -0 "${pid}" 2>/dev/null; then
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi
    wait "${pid}" 2>/dev/null || true
}

# One Gradle invocation prepares the launch files. runServer and runClient
# cannot run together: the second waits on the project lock, and stopping the
# wrapper does not stop a daemon-owned server JVM. The server is this shell's
# child, so the exit trap can stop that pid when the client exits.
_vpp_play_inside() {
    cd "${_VPP_ROOT}" || return
    _vpp_ensure_display || return
    local port java_bin server_args client_args launch_cfg
    port="$(_vpp_server_port)"
    if _vpp_port_open "${port}"; then
        echo "vpp: port ${port} is already open. Stop that server before vpp-play." >&2
        return 1
    fi
    ./gradlew compileJava compileClientJava setupRunServer downloadAssets configureLaunch || return
    port="$(_vpp_server_port)"
    if _vpp_port_open "${port}"; then
        echo "vpp: port ${port} is already open. Stop that server before vpp-play." >&2
        return 1
    fi
    java_bin="${JAVA_HOME:-}/bin/java"
    if [[ ! -x "${java_bin}" ]]; then
        java_bin="$(command -v java || true)"
    fi
    if [[ -z "${java_bin}" || ! -x "${java_bin}" ]]; then
        echo "vpp: java not found" >&2
        return 1
    fi
    server_args="${_VPP_ROOT}/build/loom-cache/argFiles/runServer"
    client_args="${_VPP_ROOT}/build/loom-cache/argFiles/runClient"
    launch_cfg="${_VPP_ROOT}/.gradle/loom-cache/launch.cfg"
    if [[ ! -f "${server_args}" || ! -f "${client_args}" || ! -f "${launch_cfg}" ]]; then
        echo "vpp: Loom launch files are missing after configureLaunch." >&2
        return 1
    fi
    (
        server_pid=0
        stopped=0
        _vpp_play_stop() {
            [[ "${stopped}" -eq 1 ]] && return 0
            stopped=1
            _vpp_stop_pid "${server_pid}"
        }
        trap _vpp_play_stop EXIT
        trap '_vpp_play_stop; exit 130' INT
        trap '_vpp_play_stop; exit 143' TERM
        mkdir -p "${_VPP_ROOT}/run/logs"
        cd "${_VPP_ROOT}/run" || exit 1
        echo "vpp: dedicated server on port ${port}. Log: run/logs/vpp-server.log" >&2
        # Non-interactive bash does not put this job in its own process group,
        # so setsid can take this pid over instead of forking a leader we would
        # lose. A terminal interrupt then hits the client, and the trap stops
        # this pid.
        if command -v setsid >/dev/null 2>&1; then
            setsid "${java_bin}" \
                -Dfabric.dli.config="${launch_cfg}" \
                -Dfabric.dli.env=server \
                -Dfabric.dli.main=net.fabricmc.loader.impl.launch.knot.KnotServer \
                -Dvpp.debug=true \
                @"${server_args}" \
                net.fabricmc.devlaunchinjector.Main nogui \
                >"${_VPP_ROOT}/run/logs/vpp-server.log" 2>&1 </dev/null &
        else
            "${java_bin}" \
                -Dfabric.dli.config="${launch_cfg}" \
                -Dfabric.dli.env=server \
                -Dfabric.dli.main=net.fabricmc.loader.impl.launch.knot.KnotServer \
                -Dvpp.debug=true \
                @"${server_args}" \
                net.fabricmc.devlaunchinjector.Main nogui \
                >"${_VPP_ROOT}/run/logs/vpp-server.log" 2>&1 </dev/null &
        fi
        server_pid=$!
        ready=0
        for ((i = 1; i <= 180; i++)); do
            if ! kill -0 "${server_pid}" 2>/dev/null; then
                echo "vpp: dedicated server exited before it listened. See run/logs/vpp-server.log" >&2
                exit 1
            fi
            if _vpp_port_open "${port}"; then
                ready=1
                break
            fi
            sleep 1
        done
        if [[ "${ready}" -ne 1 ]]; then
            echo "vpp: dedicated server did not open port ${port}. See run/logs/vpp-server.log" >&2
            exit 1
        fi
        address="localhost"
        if [[ "${port}" != "25565" ]]; then
            address="localhost:${port}"
        fi
        "${java_bin}" \
            -Dfabric.dli.config="${launch_cfg}" \
            -Dfabric.dli.env=client \
            -Dfabric.dli.main=net.fabricmc.loader.impl.launch.knot.KnotClient \
            -Dvpp.debug=true \
            @"${client_args}" \
            net.fabricmc.devlaunchinjector.Main \
            --username Dev \
            --quickPlayMultiplayer "${address}"
        exit $?
    )
}

vpp-play() {
    _vpp_exec bash -lc 'source .devcontainer/bashrc; _vpp_play_inside'
}

vpp-help() {
    cat <<'EOF'
vpp helpers (source .devcontainer/bashrc)

container
  vpp-up              start/ensure the devcontainer (host)
  vpp-down            stop and remove the container (host)
  vpp-exec ...        run an arbitrary command in the container

gradle
  vpp-test            ./gradlew test
  vpp-game-test       ./gradlew runGameTest
  vpp-client-test     ./gradlew runClientGameTest (Xvfb when there is no display)
  vpp-build           ./gradlew build
  vpp-datagen         ./gradlew runDatagen
  vpp-server          ./gradlew runServer
  vpp-client          ./gradlew runClient (Xvfb when there is no display)
  vpp-play            dedicated server, then the client; stops the server when the client exits

Host interactive shells trap EXIT/HUP: closing the last such terminal usually
runs vpp-down. Sibling shells keep a refcount. kill -9 / crash can miss it.
VS Code attached sessions also stop on window/folder close (shutdownAction).
EOF
}

if ! _vpp_in_container && [[ $- == *i* ]] && [[ -z "${_VPP_TRAP_INSTALLED:-}" ]]; then
    _VPP_TRAP_INSTALLED=1
    _vpp_ref_do inc || true
    trap '_vpp_on_hangup' EXIT HUP
fi

if _vpp_in_container; then
    export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-25-temurin}"
    export PATH="${JAVA_HOME}/bin:${PATH}"
fi
